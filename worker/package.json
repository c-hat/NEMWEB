{
  "name": "nemweb-live-pinger",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker cron that triggers the NEMWEB live-data GitHub workflow every ~10 min.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "tsc -p tsconfig.test.json && node --test .tmp/test-dist/*.test.js",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts",
    "check:startup": "wrangler check startup"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.7.3",
    "wrangler": "^4.120.0"
  }
}
